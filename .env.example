FRP_USERNAME=your_account_or_email_or_phone
FRP_PASSWORD=your_password
# 签到方式顺序（checkin-v2.js 使用）：auto=方法A(纯API)优先、失败回退方法B(浏览器)
# 也可填 api / browser / browser,api
CHECKIN_STRATEGY=auto
# 方法A 单个请求超时（毫秒），默认 15000
FRP_API_TIMEOUT_MS=15000

# ============================================================
# 推送渠道（全部可选，配了才启用，可同时启用多个；未配置的自动跳过）
# ============================================================

# PushDeer
SENDKEY=
# Server酱（ServerChan³ 的 SendKey，形如 SCTxxxxx）
SERVERCHAN_KEY=
# Telegram Bot
TG_BOT_TOKEN=
TG_CHAT_ID=
# PushPlus（PUSHPLUS_CHANNEL 可选：wechat / webhook / mail 等，不填用后台默认渠道）
PUSHPLUS_TOKEN=
PUSHPLUS_CHANNEL=
# 钉钉机器人（机器人若开启加签校验，需同时填 DINGTALK_SECRET）
DINGTALK_WEBHOOK=
DINGTALK_SECRET=
# 飞书机器人（机器人若开启加签校验，需同时填 FEISHU_SECRET）
FEISHU_WEBHOOK=
FEISHU_SECRET=
# 企业微信机器人（群机器人 Webhook 地址）
WECOM_BOT_WEBHOOK=
# 云湖机器人（YUNHU_RECV_TYPE 可选，默认 group）
YUNHU_TOKEN=
YUNHU_RECV_ID=
YUNHU_RECV_TYPE=group
# Bark（BARK_SERVER 默认 https://api.day.app，自建服务可覆盖；BARK_GROUP 可选）
BARK_KEY=
BARK_SERVER=https://api.day.app
BARK_GROUP=
# WxPusher（还需 WXPUSHER_UIDS 或 WXPUSHER_TOPIC_IDS 二者之一，否则无法确定接收人）
WXPUSHER_TOKEN=
WXPUSHER_UIDS=
WXPUSHER_TOPIC_IDS=
# 自定义 Webhook（以下增强项都可选，不配即用默认行为）
WEBHOOK_URL=
WEBHOOK_METHOD=POST
WEBHOOK_CONTENT_TYPE=json
WEBHOOK_HEADERS=
WEBHOOK_BODY=

# ============================================================
# 推送调优（可选）
# ============================================================
# 单个渠道请求超时（毫秒），默认 15000
PUSH_TIMEOUT_MS=15000
# 可重试错误（网络异常 / 429 / 5xx）的最大重试次数，默认 2
PUSH_MAX_RETRY=2
# 重试退避初始值与上限（毫秒），默认 1000 / 8000
PUSH_RETRY_MIN_WAIT_MS=1000
PUSH_RETRY_MAX_WAIT_MS=8000
# 设为 1 时，已配置渠道全部失败才让推送步骤失败退出；默认不开启，避免推送失败把签到运行标红
PUSH_STRICT=0
