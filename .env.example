FRP_USERNAME=your_account_or_email_or_phone
FRP_PASSWORD=your_password

# ============================================================
# 浏览器签到
# ============================================================
# 浏览器通道，默认 chromium（不要填 msedge，服务器上一般没装 Edge）
FRP_BROWSER_CHANNEL=chromium
# 是否无头，默认 true。无显示器 / cron 环境必须为 true
FRP_BROWSER_HEADLESS=true
# 整体超时（毫秒），默认见 src/browser.js
# FRP_TIMEOUT_MS=180000
# 调试产物目录（可选，失败时落截图与 HTML）
# FRP_DEBUG_DIR=debug-artifacts
# 是否屏蔽第三方资源（可选，默认不屏蔽）
# FRP_BLOCK_THIRD_PARTY=0
# 浏览器 profile 目录（可选，默认工作目录下的 .browser-profile）
# 登录态与 HTTP 缓存都存在这里，跨运行复用。删掉它会退回到「每次重新登录」
# FRP_PROFILE_DIR=/opt/52frp-checkin/.browser-profile
# 是否启用 HTTP 缓存（可选，默认启用）。设为 0 可退回「每次都重新拉取全部资源」
# FRP_CACHE_ENABLED=1
# 单个资源返回 5xx 时的重试次数（可选，默认 3）。跨境链路上这项是关键，
# 设 0 可关闭；链路很好时可设 1 减少耗时
# FRP_ASSET_RETRY=3
# 串行预热（可选，默认开启）。goto 之前先把静态资源一个一个排队拉进缓存，
# 把浏览器的「几十个并发请求」压到个位数 —— 境外跑这条链路时，它是关键。
# 设 0 关闭；链路本来就好时可以关掉省时间
# FRP_PRELOAD=1
# FRP_PRELOAD_MAX=60
# FRP_PRELOAD_RETRY=2
# FRP_PRELOAD_BUDGET_MS=240000
# 是否屏蔽第一方的装饰性图片与字体（可选，默认关闭）。
# 能进一步减少并发，但滑块验证码若依赖图片就不要开
# FRP_BLOCK_MEDIA=0
# 整轮重来的轮数与总预算（可选，默认 5 轮 / 30 分钟，间隔 45/60/90/120s 递增）。
# 522 窗口长短不一，多轮 + 短起递增的间隔最划算
# FRP_ROUNDS=5
# FRP_TOTAL_BUDGET_MS=1800000

# ============================================================
# 推送渠道（全部可选，配了才启用，可同时启用多个；未配置的自动跳过）
# ============================================================

# PushDeer
SENDKEY=
# Server酱（ServerChan³ 的 SendKey，形如 SCTxxxxx）
SERVERCHAN_KEY=
# Telegram Bot
TG_BOT_TOKEN=
TG_CHAT_ID=
# PushPlus（PUSHPLUS_CHANNEL 可选：wechat / webhook / mail 等，不填用后台默认渠道）
PUSHPLUS_TOKEN=
PUSHPLUS_CHANNEL=
# 钉钉机器人（机器人若开启加签校验，需同时填 DINGTALK_SECRET）
DINGTALK_WEBHOOK=
DINGTALK_SECRET=
# 飞书机器人（机器人若开启加签校验，需同时填 FEISHU_SECRET）
FEISHU_WEBHOOK=
FEISHU_SECRET=
# 企业微信机器人（群机器人 Webhook 地址）
WECOM_BOT_WEBHOOK=
# 云湖机器人（YUNHU_RECV_TYPE 可选，默认 group）
YUNHU_TOKEN=
YUNHU_RECV_ID=
YUNHU_RECV_TYPE=group
# Bark（BARK_SERVER 默认 https://api.day.app，自建服务可覆盖；BARK_GROUP 可选）
BARK_KEY=
BARK_SERVER=https://api.day.app
BARK_GROUP=
# WxPusher（还需 WXPUSHER_UIDS 或 WXPUSHER_TOPIC_IDS 二者之一，否则无法确定接收人）
WXPUSHER_TOKEN=
WXPUSHER_UIDS=
WXPUSHER_TOPIC_IDS=
# 自定义 Webhook（以下增强项都可选，不配即用默认行为）
WEBHOOK_URL=
WEBHOOK_METHOD=POST
WEBHOOK_CONTENT_TYPE=json
WEBHOOK_HEADERS=
WEBHOOK_BODY=

# ============================================================
# 推送调优（可选）
# ============================================================
# 单个渠道请求超时（毫秒），默认 15000
PUSH_TIMEOUT_MS=15000
# 可重试错误（网络异常 / 429 / 5xx）的最大重试次数，默认 2
PUSH_MAX_RETRY=2
# 重试退避初始值与上限（毫秒），默认 1000 / 8000
PUSH_RETRY_MIN_WAIT_MS=1000
PUSH_RETRY_MAX_WAIT_MS=8000
# 设为 1 时，已配置渠道全部失败才让推送步骤失败退出；默认不开启，避免推送失败把签到运行标红
PUSH_STRICT=0
